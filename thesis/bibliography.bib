  booktitle = {2024 4th {{International Conference}} on {{Pervasive Computing}} and {{Social Networking}} ({{ICPCSN}})},
  author = {Vayadande, Kuldeep and Bhat, Aditi and Bachhav, Pranav and Bhoyar, Aditya and Charoliya, Zulfikar and Chavan, Aayush},
